{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window and the manual / about / heatmap windows",
  "windows": ["main", "about", "manual", "heatmap"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default"
  ]
}
