{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Advanced SNES ROM Utility JS",
  "version": "2.0.0",
  "identifier": "de.snes-projects.advanced-snes-rom-utility-js",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "node scripts/bundle-core.js",
    "beforeBuildCommand": "node scripts/bundle-core.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Advanced SNES ROM Utility JS v2.0",
        "width": 542,
        "height": 571,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Tool for SNES / SFC ROMs",
    "longDescription": "An easy to use utility for performing some tasks on SNES / SFC ROMs.",
    "copyright": "©2021 - 2026 Dom aka Doke",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sfc",
          "smc",
          "swc",
          "fig"
        ],
        "name": "SNES ROM",
        "description": "SNES / SFC ROM",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
